const ADD_TO_PLAYLIST_OPEN = 'ADD_TO_PLAYLIST_OPEN';
const ADD_TO_PLAYLIST_CLOSE = 'ADD_TO_PLAYLIST_CLOSE';
const DOWNLOAD_MENU_OPEN = 'DOWNLOAD_MENU_OPEN';
const DOWNLOAD_MENU_CLOSE = 'DOWNLOAD_MENU_CLOSE';
const DUPLICATE_SONG_WARNING_OPEN = 'DUPLICATE_SONG_WARNING_OPEN';
const DUPLICATE_SONG_WARNING_CLOSE = 'DUPLICATE_SONG_WARNING_CLOSE';
const EXTENDED_INFO_OPEN = 'EXTENDED_INFO_OPEN';
const EXTENDED_INFO_CLOSE = 'EXTENDED_INFO_CLOSE';
const LISTENBRAINZ_TOKEN_OPEN = 'LISTENBRAINZ_TOKEN_OPEN';
const LISTENBRAINZ_TOKEN_CLOSE = 'LISTENBRAINZ_TOKEN_CLOSE';
const SAVE_QUEUE_OPEN = 'SAVE_QUEUE_OPEN';
const SAVE_QUEUE_CLOSE = 'SAVE_QUEUE_CLOSE';
const DOWNLOAD_MENU_ALBUM = 'album';
const DOWNLOAD_MENU_ARTIST = 'artist';
const DOWNLOAD_MENU_PLAY = 'playlist';
const DOWNLOAD_MENU_SONG = 'song';
const SHARE_MENU_OPEN = 'SHARE_MENU_OPEN';
const SHARE_MENU_CLOSE = 'SHARE_MENU_CLOSE';

const openShareMenu = (ids, resource, name, label) => ({
  type: SHARE_MENU_OPEN,
  ids,
  resource,
  name,
  label,
});

const closeShareMenu = () => ({
  type: SHARE_MENU_CLOSE,
});

const openAddToPlaylist = ({ selectedIds, onSuccess }) => ({
  type: ADD_TO_PLAYLIST_OPEN,
  selectedIds,
  onSuccess,
});

const closeAddToPlaylist = () => ({
  type: ADD_TO_PLAYLIST_CLOSE,
});

const openDownloadMenu = (record, recordType) => {
  return {
    type: DOWNLOAD_MENU_OPEN,
    recordType,
    record,
  }
};

const closeDownloadMenu = () => ({
  type: DOWNLOAD_MENU_CLOSE,
});

const openDuplicateSongWarning = (duplicateIds) => ({
  type: DUPLICATE_SONG_WARNING_OPEN,
  duplicateIds,
});

const closeDuplicateSongDialog = () => ({
  type: DUPLICATE_SONG_WARNING_CLOSE,
});

const openExtendedInfoDialog = (record) => {
  return {
    type: EXTENDED_INFO_OPEN,
    record,
  }
};

const closeExtendedInfoDialog = () => ({
  type: EXTENDED_INFO_CLOSE,
});

const openListenBrainzTokenDialog = () => ({
  type: LISTENBRAINZ_TOKEN_OPEN,
});

const closeListenBrainzTokenDialog = () => ({
  type: LISTENBRAINZ_TOKEN_CLOSE,
});

const openSaveQueueDialog = () => ({
  type: SAVE_QUEUE_OPEN,
});

const closeSaveQueueDialog = () => ({
  type: SAVE_QUEUE_CLOSE,
})

