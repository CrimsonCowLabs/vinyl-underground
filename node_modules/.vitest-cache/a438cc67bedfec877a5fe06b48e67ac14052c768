const REST_URL = '/api';

const APP_NAME = 'Vinyl Underground';
const SOURCE_REPO = 'github.com/CrimsonCowLabs/vinyl-underground';

// Vinyl Underground is a fork of Navidrome. Credit it without implying endorsement.
const UPSTREAM_NAME = 'Navidrome';
const UPSTREAM_VERSION = '0.64.2';
const UPSTREAM_LICENSE = 'GPL-3.0';
const UPSTREAM_REPO = 'github.com/navidrome/navidrome';

const INSIGHTS_DOC_URL =
  'https://navidrome.org/docs/getting-started/insights';

const M3U_MIME_TYPE = 'audio/x-mpegurl';

const AUTO_THEME_ID = 'AUTO_THEME_ID';

const AUTO_THEME_CONFIG_VALUE = 'Auto';

const DraggableTypes = {
  SONG: 'song',
  ALBUM: 'album',
  DISC: 'disc',
  ARTIST: 'artist',
  ALL: [],
};

DraggableTypes.ALL.push(
  DraggableTypes.SONG,
  DraggableTypes.ALBUM,
  DraggableTypes.DISC,
  DraggableTypes.ARTIST,
);

const RADIO_PLACEHOLDER_IMAGE = 'internet-radio-icon.svg';

const DEFAULT_SHARE_BITRATE = 128;

const BITRATE_CHOICES = [
  32, 48, 64, 80, 96, 112, 128, 160, 192, 256, 320,
].map((b) => ({ id: b, name: b.toString() }));

// 0 is a valid stored value ("no default bit rate") that BITRATE_CHOICES cannot express.
const TRANSCODING_BITRATE_CHOICES = [
  { id: 0, name: 'resources.transcoding.choices.noDefaultBitRate' },
  ...BITRATE_CHOICES,
]

