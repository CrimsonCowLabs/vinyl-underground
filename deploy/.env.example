# Vinyl Underground settings. Optional: with no .env at all, every value
# below falls back to the default shown.
#
# To change something: cp .env.example .env, then uncomment and edit only the
# lines you need. .env is gitignored; never commit it.

# ---------------------------------------------------------------------------
# Host and container
# ---------------------------------------------------------------------------

# Host folder where the music share is mounted. Mounted read-only into the app.
# Clean it first (contrib/library-cleanup) so no Duplicates are scanned.
# VU_LIBRARY_DIR=/mnt/music

# Host folder for the database, cache, config and backups (relative to deploy/).
# VU_DATA_DIR=./data

# Host folder for the Inbox, where new music lands before it joins the Library
# (relative to deploy/). Mounted read-write at /inbox, apart from VU_DATA_DIR.
# Files copied in become Tracks after a scan, seen only by the admin.
# VU_INBOX_DIR=./inbox

# User and group the app runs as. Use `id -u` / `id -g` of whoever should own
# VU_DATA_DIR and VU_INBOX_DIR; that user also needs read access to
# VU_LIBRARY_DIR.
# VU_UID=1000
# VU_GID=1000

# Loopback port that `tailscale serve` proxies to.
# VU_PORT=4533

# The machine's tailnet name. Compose doesn't use it; the checks in
# deploy/README.md work it out from `tailscale status` when it's unset.
# VU_TS_HOSTNAME=music-host.example-tailnet.ts.net

# ---------------------------------------------------------------------------
# App settings (ND_*). Any Navidrome option can be set here as ND_<NAME>;
# nested options use _ (Backup.Path -> ND_BACKUP_PATH). Values shown are the
# defaults.
# ---------------------------------------------------------------------------

# Logging: error, warn, info, debug, trace.
# ND_LOGLEVEL=info

# The Inbox folder inside the container, scanned as a second library that only
# the admin can see. It must not overlap the Library. Empty, or a missing
# folder, means no Inbox library is set up; one that already exists stays until
# an admin deletes it under Libraries.
# ND_INBOX_PATH=/inbox

# Ripping: the admin pastes a video link and its audio lands in the Inbox,
# fetched with yt-dlp (downloaded into VU_DATA_DIR/bin on first use). Off by
# default. You are responsible for what you download.
# ND_RIPPING_ENABLED=false
# A Rip that takes longer than this is stopped and marked failed.
# ND_RIPPING_TIMEOUT=30m

# Library rescan schedule (cron or "@every 24h"). The file watcher can miss
# changes on network mounts, so a scheduled rescan is on by default.
# ND_SCANNER_SCHEDULE="@every 24h"

# How long a login lasts.
# ND_SESSIONTIMEOUT=48h

# Theme and language for Listeners who haven't picked one.
# ND_DEFAULTTHEME=Dark
# ND_DEFAULTLANGUAGE=

# Playlists are private by default; true makes new ones shared.
# ND_DEFAULTPLAYLISTPUBLICVISIBILITY=false

# Downloads, and whether downloads are transcoded with the stream format.
# ND_ENABLEDOWNLOADS=true
# ND_AUTOTRANSCODEDOWNLOAD=false

# Disk cache for transcoded streams (Opus on phones) and artwork.
# ND_TRANSCODINGCACHESIZE=100MB
# ND_IMAGECACHESIZE=100MB

# Backups: `navidrome backup create` writes to ND_BACKUP_PATH. Set a schedule
# (cron) and count to also back up automatically.
# ND_BACKUP_PATH=/data/backup
# ND_BACKUP_SCHEDULE="0 4 * * *"
# ND_BACKUP_COUNT=7

# Last.fm artist info and similar artists. Needs an API account from
# https://www.last.fm/api/account/create; lookups are off while these are empty.
# Scrobbling only happens for a Listener who links Last.fm in their settings.
# ND_LASTFM_APIKEY=
# ND_LASTFM_SECRET=

# Turn off all outside metadata lookups (Last.fm, Deezer, ListenBrainz).
# ND_ENABLEEXTERNALSERVICES=true
