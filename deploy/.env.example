# Copy to deploy/.env (gitignored) and fill in your own values.
# Every value below is a placeholder. Never commit the real .env.

# Host folder where the read-only music share is mounted. Clean it first
# (contrib/library-cleanup and the Quarantine recipe) so no Duplicates are scanned.
VU_LIBRARY_DIR=/mnt/music

# Host folder for the database, cache and config. Must be writable by VU_UID.
VU_DATA_DIR=./data

# User and group the app runs as (`id -u`, `id -g` on the host).
VU_UID=1000
VU_GID=1000

# Loopback port that `tailscale serve` proxies to.
VU_PORT=4533

# The machine's tailnet name. Compose doesn't use it; the checks in deploy/README.md do.
# Find it with `tailscale status --json | jq -r .Self.DNSName` (drop the trailing dot).
VU_TS_HOSTNAME=music-host.example-tailnet.ts.net

# Last.fm metadata lookups (artist info, similar artists), which the design turns on.
# They need an API account from https://www.last.fm/api/account/create; with these
# empty, Last.fm lookups are off. Scrobbling stays off: it only happens for a Listener
# who links a Last.fm account in their personal settings.
ND_LASTFM_APIKEY=
ND_LASTFM_SECRET=

# Optional overrides.
# ND_LOGLEVEL=info
# ND_SCANNER_SCHEDULE="@every 24h"
