# Vinyl Underground settings. Optional: with no .env at all, every value
# below falls back to the default shown.
#
# To change something: cp .env.example .env, then uncomment and edit only the
# lines you need. .env is gitignored; never commit it.

# ---------------------------------------------------------------------------
# Host and container
# ---------------------------------------------------------------------------

# Host folder where the music share is mounted. Mounted read-only into the app.
# Clean it first (contrib/library-cleanup) so no Duplicates are scanned.
# VU_LIBRARY_DIR=/mnt/music

# Host folder for the database, cache, config and backups (relative to deploy/).
# VU_DATA_DIR=./data

# Host folder for the Inbox, where new music lands before it joins the Library
# (relative to deploy/). Mounted read-write at /inbox, apart from VU_DATA_DIR.
# Files copied in become Tracks after a scan, seen only by the admin.
# VU_INBOX_DIR=./inbox

# Promote (off unless set): a second, read-write host mount of just the share's
# "Vinyl Underground" folder, bound over /music/Vinyl Underground. Both lines
# together turn it on; see deploy/README.md, section 12, for the host mount.
# COMPOSE_FILE=docker-compose.yml:docker-compose.promote.yml
# VU_PROMOTE_DIR=/mnt/vinyl-underground

# User and group the app runs as. Use `id -u` / `id -g` of whoever should own
# VU_DATA_DIR and VU_INBOX_DIR; that user also needs read access to
# VU_LIBRARY_DIR.
# VU_UID=1000
# VU_GID=1000

# Loopback port that `tailscale serve` proxies to.
# VU_PORT=4533

# Only with `--profile ollama` (an LLM on this host): where Ollama keeps its
# models (relative to deploy/), and how long a model stays loaded after a
# request.
# VU_OLLAMA_DIR=./ollama
# VU_OLLAMA_KEEP_ALIVE=30m

# The machine's tailnet name. Compose doesn't use it; the checks in
# deploy/README.md work it out from `tailscale status` when it's unset.
# VU_TS_HOSTNAME=music-host.example-tailnet.ts.net

# ---------------------------------------------------------------------------
# App settings (ND_*). Any Navidrome option can be set here as ND_<NAME>;
# nested options use _ (Backup.Path -> ND_BACKUP_PATH). Values shown are the
# defaults.
# ---------------------------------------------------------------------------

# Logging: error, warn, info, debug, trace.
# ND_LOGLEVEL=info

# The Inbox folder inside the container, scanned as a second library that only
# the admin can see. It must not overlap the Library. Empty, or a missing
# folder, means no Inbox library is set up; one that already exists stays until
# an admin deletes it under Libraries.
# ND_INBOX_PATH=/inbox

# The folder Promote moves reviewed Inbox Files into, inside the container. It
# must be inside the Library (not the Inbox) and writable; it is checked on
# start, and Promote stays off if it isn't usable. Empty turns Promote off.
# docker-compose.promote.yml sets it to "/music/Vinyl Underground".
# ND_INBOX_PROMOTEPATH=

# Ripping: the admin pastes a video link and its audio lands in the Inbox,
# fetched with yt-dlp (downloaded into VU_DATA_DIR/bin on first use). Off by
# default. You are responsible for what you download.
# ND_RIPPING_ENABLED=false
# A Rip that takes longer than this is stopped and marked failed.
# ND_RIPPING_TIMEOUT=30m
# When yt-dlp is updated to its latest release (cron, "@daily" or "@every 24h").
# "0" turns the scheduled updates off; the Rips page's "Update yt-dlp" button
# and the update after a failed Rip still work.
# ND_RIPPING_YTDLPUPDATESCHEDULE=@daily
# Look up each Rip's album and year on MusicBrainz for the review card's
# proposed tags (about one request a second). Off, proposals come from YouTube
# Music's metadata or the video's title alone.
# ND_RIPPING_MUSICBRAINZ=true

# Library rescan schedule (cron or "@every 24h"). The file watcher can miss
# changes on network mounts, so a scheduled rescan is on by default.
# ND_SCANNER_SCHEDULE="@every 24h"

# How long a login lasts.
# ND_SESSIONTIMEOUT=48h

# Theme and language for Listeners who haven't picked one.
# ND_DEFAULTTHEME=Dark
# ND_DEFAULTLANGUAGE=

# Playlists are private by default; true makes new ones shared.
# ND_DEFAULTPLAYLISTPUBLICVISIBILITY=false

# Downloads, and whether downloads are transcoded with the stream format.
# ND_ENABLEDOWNLOADS=true
# ND_AUTOTRANSCODEDOWNLOAD=false

# Disk cache for transcoded streams (Opus on phones) and artwork.
# ND_TRANSCODINGCACHESIZE=100MB
# ND_IMAGECACHESIZE=100MB

# Backups: `navidrome backup create` writes to ND_BACKUP_PATH. Set a schedule
# (cron) and count to also back up automatically.
# ND_BACKUP_PATH=/data/backup
# ND_BACKUP_SCHEDULE="0 4 * * *"
# ND_BACKUP_COUNT=7

# Last.fm artist info and similar artists (Generated Playlists use them to find
# Tracks by artists like the ones the LLM suggests). Needs an API key from
# https://www.last.fm/api/account/create; Last.fm lookups are off while it is
# empty, and Deezer still answers. Artist and album names are sent to Last.fm.
# Nothing is ever scrobbled: this app can't link a Last.fm account, so the
# secret isn't needed.
# ND_LASTFM_APIKEY=
# The metadata sources, asked in order until one answers.
# ND_AGENTS=lastfm,deezer,listenbrainz

# Outside metadata lookups (Last.fm, Deezer, ListenBrainz) are on. false turns
# them all off; Generated Playlists then use the Library's own tags alone.
# ND_ENABLEEXTERNALSERVICES=true

# The LLM for Generated Playlists and Station Themes: any OpenAI-compatible
# endpoint (Ollama, llama.cpp, LM Studio). With either of URL or model empty,
# Generated Playlists and the Theme field are hidden, and Stations pick by rule.
# The URL is the OpenAI-style base; one with no path gets /v1.
# Use a GGUF build of the model: Ollama's MLX builds refuse JSON-schema output.
# A tailnet machine needs its full MagicDNS name (or tailnet IP): Docker's DNS
# inside the container doesn't add the tailnet's search domain, so a short
# name like "llm-host" fails with "bad address".
#   Another machine on the tailnet: ND_LLM_BASEURL=http://llm-host.example-tailnet.ts.net:11434
#   The `ollama` compose profile:   ND_LLM_BASEURL=http://ollama:11434
# ND_LLM_BASEURL=
# Both are empty by default; the model must be set too. For example:
# ND_LLM_MODEL=qwen3.5:4b-q4_K_M
# Only for endpoints that need one; Ollama doesn't.
# ND_LLM_APIKEY=
# How long one LLM call may take, and how long to wait to reach the endpoint
# before saying "AI unavailable" (e.g. the LLM host is asleep).
# ND_LLM_TIMEOUT=3m
# ND_LLM_CONNECTTIMEOUT=5s
